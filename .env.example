# Backend Configuration
BACKEND_PORT=8080
JAVA_OPTS=-Xmx512m -Xms256m
# For local development you can skip the token:
# set CONFIG_PATH=config/config-local.json, which uses
# "apiAuth": { "type": "unsecured" }. This disables API auth entirely —
# keep the backend bound to 127.0.0.1.
CONFIG_PATH=config/config.json

# REQUIRED: admin API bearer token. The example config resolves it via
# @SYSENV:HOMER_ADMIN_TOKEN, and startup fails if it is empty or unset — so no
# working credential ships by default. Generate a strong value before starting,
# e.g.  echo "HOMER_ADMIN_TOKEN=$(openssl rand -hex 24)" >> .env
HOMER_ADMIN_TOKEN=

# Frontend Configuration
FRONTEND_PORT=3000
AUTH_ENABLED=false

# Important: For development mode, the frontend makes API calls from the browser,
# so it needs to use localhost. This is overridden in docker-compose.dev.yml.
# For production with reverse proxy, set this to your actual backend URL.
# CONSOLE_HOMER_API_URL=http://localhost:8080

# Runtime console plugins and themes, comma-separated; the files must be in the
# console image under public/ (see DOCKER.md).
# CONSOLE_PLUGINS=/plugins/costs.js@admin
# CONSOLE_THEMES=acme:/themes/acme.css
# CONSOLE_THEME_MODES=light:acme,dark:acme

# Docker Configuration
COMPOSE_PROJECT_NAME=homer
