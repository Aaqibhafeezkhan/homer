# Backend Configuration
BACKEND_PORT=8080
# Tag of the published release images (backend and console) the compose stack
# pulls. Defaults to the pinned current release; set a released version to move,
# or build from source with docker-compose.build.yml (see DOCKER.md).
# HOMER_VERSION=1.38.0
JAVA_OPTS=-Xmx512m -Xms256m
# For local development you can skip the token:
# set CONFIG_PATH=config/config-local.json, which uses
# "apiAuth": { "type": "unsecured" }, and AUTH_ENABLED=false below. This
# disables API auth entirely — keep the backend bound to 127.0.0.1.
CONFIG_PATH=config/config.json

# REQUIRED: admin API bearer token. The example config resolves it via
# @SYSENV:HOMER_ADMIN_TOKEN, and startup fails if it is empty or unset — so no
# working credential ships by default. Generate a strong value before starting,
# e.g.  echo "HOMER_ADMIN_TOKEN=$(openssl rand -hex 24)" >> .env
HOMER_ADMIN_TOKEN=

# Frontend Configuration
# Also passed to the backend: the example configs allow the console origin
# http://localhost:<FRONTEND_PORT> via @SYSENV:FRONTEND_PORT, so changing the
# port here is the only step.
FRONTEND_PORT=3000
# Console sign-in. The example backend is bearer-only, so sign in on the
# console's Token tab with HOMER_ADMIN_TOKEN. The browser then keeps the token
# in localStorage, where an XSS bug could read it — acceptable for this
# loopback-only quick start. For a real deployment use cookie sign-in (a
# password scheme, see app/SERVER.md "Password Authentication") and leave
# CONSOLE_ALLOW_BEARER off.
AUTH_ENABLED=true
CONSOLE_ALLOW_BEARER=true

# Important: For development mode, the frontend makes API calls from the browser,
# so it needs to use localhost. This is overridden in docker-compose.dev.yml.
# For production with reverse proxy, set this to your actual backend URL.
# Defaults to http://localhost:<BACKEND_PORT>.
# CONSOLE_HOMER_API_URL=http://localhost:8080

# Runtime console plugins and themes, comma-separated; the files must be in the
# console image under public/ (see DOCKER.md).
# CONSOLE_PLUGINS=/plugins/costs.js@admin
# CONSOLE_THEMES=acme:/themes/acme.css
# CONSOLE_THEME_MODES=light:acme,dark:acme

# Docker Configuration
COMPOSE_PROJECT_NAME=homer
